# Linkkk backend — copy to .env and fill in. Never commit the real .env.

# --- Core (required) ---
NODE_ENV=development
PORT=4001
DATABASE_URL=postgresql://user:password@localhost:5432/linkkk
V2_AUTH_SECRET_KEY=
V2_GUEST_SECRET_KEY=
# Optional: previous secrets accepted during a key rotation
V2_AUTH_SECRET_KEY_PREVIOUS=
V2_GUEST_SECRET_KEY_PREVIOUS=
FRONTEND_URL=http://localhost:3000

# --- Stripe (required in production) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=

# --- Cloudinary (required in production) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# --- OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

# --- Email (Resend) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=notifications@linkkk.dev

# --- Monitoring ---
SENTRY_DSN=

# --- Telegram admin notifications (skipped when unset) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Link abuse protection ---
# Google Safe Browsing Lookup API v4 key (Google Cloud console → enable
# "Safe Browsing API" → API key). When unset, destination checks are skipped.
# Flagged destinations are refused on link create/update (UNSAFE_DESTINATION_URL)
# and blocked at redirect time. Any API error or timeout fails open.
GOOGLE_SAFE_BROWSING_KEY=
# Timeout for the create/update check, in ms (default 2000)
SAFE_BROWSING_TIMEOUT_MS=2000
# Re-check the destination on every redirect (cached per URL: 30 min clean,
# 6 h flagged). Set to "false" to disable (default enabled when a key is set).
SAFE_BROWSING_CHECK_ON_REDIRECT=true
# Timeout for the redirect-time check on a cache miss, in ms (default 800)
SAFE_BROWSING_REDIRECT_TIMEOUT_MS=800
# Accounts younger than this (days) linking to free-hosting subdomains often used
# for phishing (*.wasmer.app, *.pages.dev, *.vercel.app…) trigger a Telegram
# warning. Never blocks. Guests always count as new. (default 7)
ABUSE_NEW_ACCOUNT_DAYS=7
# Burst alert: a link of an account younger than ABUSE_BURST_ACCOUNT_DAYS (or a
# guest) getting ABUSE_BURST_THRESHOLD accesses within one hour (bots included)
# sends one Telegram alert, then stays quiet for ABUSE_BURST_COOLDOWN_HOURS.
ABUSE_BURST_THRESHOLD=30
ABUSE_BURST_ACCOUNT_DAYS=7
ABUSE_BURST_COOLDOWN_HOURS=6
